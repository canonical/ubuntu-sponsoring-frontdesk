#!/bin/bash
# Runs as root when the workshop is built or refreshed.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update

# The bot runs on system Python: apt_pkg (python3-apt) is a compiled
# extension tied to it, so these are distro packages, not pip installs.
# python3-pip is only needed by the ruff step below (a minimal image lacks
# it).
apt-get install --no-install-recommends -y \
    python3-apt \
    python3-debian \
    python3-launchpadlib \
    python3-yaml \
    python3-pytest \
    python3-pip \
    distro-info \
    git \
    make

# Checks 13/19 delegate to ubuntu-lint (>= 0.3, from the archive since its
# 26.04 SRU; #195 dropped the PPA). Best effort here: without it the checks
# fail safe and their tests skip via pytest.importorskip.
apt-get install --no-install-recommends -y python3-ubuntu-lint \
    || echo "note: python3-ubuntu-lint unavailable; Checks 13/19 will be skipped"

# ruff is pinned to the version CI uses (#108: an unpinned ruff drifted and
# broke CI on its own). Not packaged for every series, hence pip.
python3 -m pip install --break-system-packages "ruff==0.15.21"
