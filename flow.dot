digraph SponsoringBot {
    rankdir=TB;
    bgcolor="white";
    node [fontname="Helvetica", fontsize=11, style="filled", color="#333333"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    // ---- entry ----
    entry   [label="main()\n--url U  |  --all\nmode: dry-run | interactive | yes\n--force  --verbose", shape=box, fillcolor="#E8EAF6"];
    fetch   [label="--all: fetch sponsoring.json\nloop items (source_package known)", shape=box, fillcolor="#E8EAF6"];
    triage  [label="triage_url(url)", shape=box, fillcolor="#C5CAE9"];

    entry -> fetch [label="--all"];
    entry -> triage [label="--url"];
    fetch -> triage [label="per item"];

    // ---- load + facts gate ----
    load    [label="load_url → lp_obj", shape=box, fillcolor="#FFFFFF"];
    loaderr [label="load fails:\nlog, return", shape=box, fillcolor="#ECEFF1"];
    facts   [label="build_facts\n(fingerprint contributor signals:\nbugs incl. attachments +\nlinked-MP review state -- #46)", shape=box, fillcolor="#FFFFFF"];
    gate    [label="force?  OR\nstored facts ≠ new facts?", shape=diamond, fillcolor="#FFF9C4"];
    skip    [label="Skip\n(nothing changed)", shape=box, fillcolor="#ECEFF1"];

    triage -> load;
    load -> loaderr [label="error"];
    load -> facts [label="ok"];
    facts -> gate;
    gate -> skip [label="unchanged"];

    // ---- closing-tier checks (short-circuit: already resolved) ----
    c1  [label="Check 1: administrative_state\n(closing)", shape=box, fillcolor="#FFFFFF"];
    c1b [label="Check 1b: nothing_to_sponsor\n(bugs only, closing -- #46)", shape=box, fillcolor="#FFFFFF"];
    c1bnote [label="linked MP with ~ubuntu-sponsors\nreviewer or an actual review ->\nreview lives on the MP;\nno MP + no patch (sync exempt) ->\nnothing to review yet", shape=note, fillcolor="#FFFDE7"];
    c1b -> c1bnote [style=dotted, arrowhead=none];

    // ---- finding-collecting checks (keep evaluating -- #31/#44) ----
    c2 [label="Check 2: target_branch\n(merge MPs only -- #20)\n→ incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c3 [label="Check 3: mp_conflicts\n→ incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c4 [label="Check 4: empty_diff\n(closing)", shape=box, fillcolor="#FFFFFF"];
    c5 [label="Check 5: changelog_bug_reference (#25/#63)\nMPs + debdiff attachments on bugs\n→ incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c6 [label="Check 6: stale_version (#27)\nmixed: closing (done/pending),\nqueued = in upload queue (#55)\nor incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    incnote [label="every check can also return None:\na lookup failed, not \"nothing to flag\"\n-> inconclusive=True, keep going (#28)", shape=note, fillcolor="#FFFDE7"];
    c6 -> incnote [style=dotted, arrowhead=none];

    gate -> c1 [label="changed / forced"];
    c1 -> c1b [label="no / None"];
    c1b -> c2 [label="no / None"];
    c2 -> c3;
    c3 -> c4 [label="no / None"];
    c4 -> c5;
    c5 -> c6;
    c8 [label="Check 8: direct_source_edit (#60/#62)\nupstream files edited, not patched\nMPs + debdiff attachments on bugs\n→ incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c9 [label="Check 9: missing_changelog_stanza (#61)\nno debian/changelog entry in the diff\n→ incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c10 [label="Check 10: patch_not_debdiff (#64)\nplain code patch on a bug\n→ ask for a debdiff, incomplete Finding", shape=box, fillcolor="#FFFFFF"];
    c6 -> c8;
    c8 -> c9;
    c9 -> c10;

    // ---- inconclusive gate (#31 addendum) ----
    incgate [label="any check inconclusive?", shape=diamond, fillcolor="#FFF9C4"];
    silent  [label="post NOTHING, skip LLM,\npersist nothing -- the aggregate\nmust not claim completeness (#44)", shape=box, fillcolor="#ECEFF1"];
    c10 -> incgate;
    incgate -> silent [label="yes"];

    // ---- LLM phase ----
    llm  [label="LLM phase\nresource_type?", shape=diamond, fillcolor="#FFF9C4"];
    tbug [label="triage_bug", shape=box, fillcolor="#FFFFFF"];
    tmp  [label="triage_mp (#47)\nnew changelog stanza + debian/ diff\n→ stanza quality (advisory),\ndiff consistency + FFe (verify, #53)\n→ question Findings, kind-tagged", shape=box, fillcolor="#F8BBD0"];
    kind [label="SRU? Sync? neither?", shape=diamond, fillcolor="#FFF9C4"];
    rev  [label="review_sru_template /\nsync checks → opencode CLI", shape=box, fillcolor="#F8BBD0"];
    verd [label="_extract_verdict\n(fail-safe to human)\nINCOMPLETE → incomplete Finding", shape=diamond, fillcolor="#FFF9C4"];

    notifnote [label="operator notifications (#48):\nMattermost webhook, URL outside the VCS\n1) MP diff never generated (post-grace,\nobserved once at the LLM phase)\n2) importer didn't auto-close (check 6 'done';\nreplaces the MP comment when configured)\nbest-effort; dry-run only logs\n\nrich-history diagnosis (#49) on check 6 'done':\nA) .changes has no Vcs-Git keys -> tooling comment + ping\nB) ancestry of MP tip in uploaded history:\ncontained -> importer-bug comment + ping\ndiverged -> history-dropped comment + ping\nundeterminable -> plain #48 ping", shape=note, fillcolor="#FFFDE7"];
    llm -> notifnote [style=dotted, arrowhead=none];
    c6  -> notifnote [style=dotted, arrowhead=none];

    c7 [label="Check 7: sru_newer_series (#58)\nSRU: fix landed in newer series first?\ntasks/MPs/patches, LLM escape hatch\n→ advisory Finding", shape=box, fillcolor="#FFFFFF"];
    incgate -> c7 [label="no"];
    c7 -> llm [label="fired / clean\n(None -> silent, like the gate)"];
    llm -> tbug [label="bug / bug_task"];
    llm -> tmp  [label="merge_proposal"];
    tbug -> kind;
    kind -> rev [label="SRU / sync"];
    kind -> agg [label="neither"];
    rev -> verd;
    tmp -> agg;
    verd -> agg;

    // ---- findings aggregation + human-engaged gate (#44/#45) ----
    agg     [label="any findings collected?", shape=diamond, fillcolor="#FFF9C4"];
    engaged [label="human reviewer engaged?\n(MP comment by non-submitter,\nnon-bot, non-service-account\nsince current diff -- #45)", shape=diamond, fillcolor="#FFF9C4"];
    post    [label="post ONE aggregated comment\n(#44): intro + \"needs fixing\"\nbullets [+ \"nice to have\"] + closing\nMP: vote='Needs Fixing'\nbug (LLM INCOMPLETE): tasks → Incomplete", shape=box, fillcolor="#FFE0B2"];

    agg -> engaged [label="yes"];
    engaged -> post [label="no"];
    engaged -> rfh  [label="yes: suppress all findings,\nfacts persist (quiet until new push)"];
    engaged -> silent [label="history unreadable (None)"];

    // ---- conclusive states ----
    done [label="DONE\ncomment + unsubscribe_sponsors\n(MPs: no status write -- #25)", shape=box, fillcolor="#C8E6C9"];
    wait [label="WAITING_ON_CONTRIBUTOR", shape=box, fillcolor="#FFE0B2"];
    rfh  [label="READY_FOR_HUMAN\n(no writes)", shape=box, fillcolor="#B3E5FC"];
    pend [label="PENDING_ARCHIVE_IMPORT\nno comment, no writes\n(git-ubuntu importer may\nauto-close first -- #27)", shape=box, fillcolor="#D1C4E9"];

    c1  -> done [label="all Ubuntu tasks closed\n& ≥1 landed / MP Merged"];
    c1b -> done [label="review on linked MP /\nno patch to sponsor"];
    c4  -> done [label="empty diff (landed)\n(drops earlier findings)"];
    c6  -> done [label="already uploaded, old enough"];
    c6  -> pend [label="already uploaded, <24h\n(drops earlier findings)"];
    verd -> done [label="SYNCED: close as\nFix Released"];
    post -> wait [label="blocking (incomplete) findings"];
    post -> rfh  [label="question-tier only\n(advisory comment, no vote)"];
    agg  -> rfh  [label="no findings"];

    // ---- persist note ----
    persist [label="every conclusive path:\nupdate_status(url, …, facts=new_facts)\nEXCEPT pend + silent (retry next run);\nfacts also withheld when a write was\nnot performed (dry-run/declined -- #36)", shape=note, fillcolor="#FFFDE7"];
    done -> persist [style=dotted, arrowhead=none];
    wait -> persist [style=dotted, arrowhead=none];
    rfh  -> persist [style=dotted, arrowhead=none];
    pend -> persist [style=dotted, arrowhead=none];

    { rank=same; done; wait; rfh; pend; }
}
